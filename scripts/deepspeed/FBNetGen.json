{
  "train_batch_size": 12,
  "train_micro_batch_size_per_gpu": 3,
  "gradient_accumulation_steps": 1,
  "steps_per_print": 100,
  "fp32": {
    "enabled": true
  },
  "zero_optimization": {
    "stage": 2,
    "overlap_comm": true,
    "contiguous_gradients": true,
    "reduce_bucket_size": 5e8,
    "allgather_bucket_size": 5e8
  },
  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 1e-4,
      "betas": [0.9, 0.98],
      "eps": 1e-8,
      "weight_decay": 1e-4
    }
  },
  "wall_clock_breakdown": false
}

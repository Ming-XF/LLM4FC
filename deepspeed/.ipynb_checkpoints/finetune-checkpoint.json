{
  "train_batch_size": 12,
  "train_micro_batch_size_per_gpu": 2,
  "gradient_accumulation_steps": 1,
  "steps_per_print": 100,
  "fp32": {
    "enabled": true
  },
  "zero_optimization": {
    "stage": 2,
    "overlap_comm": true,
    "contiguous_gradients": true,
    "reduce_bucket_size": 500000000.0,
    "allgather_bucket_size": 500000000.0
  },
  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 1e-05,
      "betas": [
        0.9,
        0.98
      ],
      "eps": 1e-08,
      "weight_decay": 0.0001
    }
  },
  "wall_clock_breakdown": false
}
